# Copy to `.env` and fill in. Vite only exposes vars prefixed with VITE_.
# Keep real values in `.env` (gitignored) — this file is committed.

# Geoapify API key, from https://myprojects.geoapify.com/ (free plan, no card).
# Just the key itself, not a URL. This ships in the JS bundle, so restrict it
# by domain in the Geoapify dashboard under the key's allowed origins.
# Without this, the location step falls back to a static list of presets.
VITE_GEOAPIFY_KEY=
