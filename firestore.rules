rules_version = '2';

// Security rules for the sidequest Firestore database.
//
// Deploy with:  firebase deploy --only firestore:rules
// Or paste into: Firebase console -> Firestore Database -> Rules -> Publish
//
// These replace the default test-mode rules, which expire ~30 days after the
// project is created and then deny everything.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Profiles. Anyone signed in can read them — that's what powers the
    // username search on onboarding — but only you can write your own.
    match /users/{uid} {
      allow read:  if signedIn();
      allow write: if isOwner(uid);

      // Your friend list, private to you — with one exception, below.
      match /friends/{friendUid} {
        allow read, write: if isOwner(uid);

        // Accepting a friend request. The person who was asked writes *themselves*
        // into the asker's list, which is the only way a friendship can become
        // mutual without a server to do the second write.
        //
        // Narrow on purpose: the document id has to be the caller's own uid, so
        // they can only ever add themselves, and only while the invitation they
        // are answering is still pending. `friendUid` is who is being added, so
        // requiring it to equal `request.auth.uid` is what pins this to "me".
        allow create: if signedIn()
                      && request.auth.uid == friendUid
                      && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + friendUid));
      }

      // Groups you've sorted those friends into. Also private: a group is your
      // own shorthand for who to invite, not something its members can see.
      match /groups/{groupId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Handle reservations. Readable so a taken handle can be detected, and
    // claimable only by the person the document points at. Deliberately no
    // update or delete: a handle, once claimed, isn't transferable yet.
    match /usernames/{handle} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Friend requests, at `friendRequests/{fromUid}_{toUid}`.
    //
    // The document existing is the whole of the pending state: accepting and
    // ignoring both delete it. That's why there's no update rule — a request is
    // never edited, only made and answered.
    match /friendRequests/{requestId} {

      // Only the two people involved. A request is readable by its recipient so
      // it can be shown as a notification, and by its sender so the invite
      // screen can show "Requested".
      function isParty() {
        return signedIn()
               && (resource.data.fromUid == request.auth.uid
                   || resource.data.toUid == request.auth.uid);
      }

      allow read: if isParty();

      // You may only send as yourself, only to someone else, and only at the id
      // derived from the pair — which is what stops the same request being sent
      // twice, and stops anyone forging a request that appears to be from
      // someone else.
      allow create: if signedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && requestId == request.auth.uid + '_' + request.resource.data.toUid;

      // The recipient accepting or ignoring, or the sender taking it back.
      allow delete: if isParty();
    }

    // Pings, at `pings/{fromUid}_{toUid}`. Same shape as a friend request: the
    // id is derived from the pair, so pinging twice overwrites rather than
    // stacking, and nobody can forge one that looks like it came from someone
    // else.
    //
    // Unlike a request there is nothing to accept, so there is no second write
    // to authorize — the recipient only ever reads it. `update` is allowed here
    // where it isn't for a request, because re-pinging the same person lands on
    // the document that's already there; it's pinned to the sender so it can
    // only ever refresh your own ping.
    match /pings/{pingId} {

      function isParty() {
        return signedIn()
               && (resource.data.fromUid == request.auth.uid
                   || resource.data.toUid == request.auth.uid);
      }

      // The recipient, to show it as a notification; the sender, so a ping they
      // sent isn't invisible to them.
      allow read: if isParty();

      allow create: if signedIn()
                    && request.resource.data.fromUid == request.auth.uid
                    && request.resource.data.toUid != request.auth.uid
                    && pingId == request.auth.uid + '_' + request.resource.data.toUid;

      // Nudging again. The sender stays the sender and the recipient stays the
      // recipient — all that may move is the timestamp.
      allow update: if signedIn()
                    && resource.data.fromUid == request.auth.uid
                    && request.resource.data.fromUid == resource.data.fromUid
                    && request.resource.data.toUid == resource.data.toUid;

      // The sender taking it back, or the recipient clearing it.
      allow delete: if isParty();
    }

    // Plans. Readable by any signed-in user: a plan carries the uids of the
    // friends it was sent to, and each of them queries for their own.
    //
    // Writable by the host, plus the one narrow exception below that lets an
    // invited friend put themselves on the roster.
    match /plans/{planId} {

      // A join or a leave: the three attendee fields change and nothing else,
      // and the only uid that moves is the caller's own.
      //
      // Checked by size as well as membership, so a caller can't smuggle a
      // removal of someone else through alongside adding themselves — adding one
      // and removing one leaves the size unchanged, which neither branch allows.
      function isRsvp() {
        let uid    = request.auth.uid;
        // `get` with a default, because a plan written before the roster
        // existed has none of these fields and a bare read would error.
        let before = resource.data.get('attendeeUids', []);
        let after  = request.resource.data.get('attendeeUids', []);
        return uid in resource.data.get('audienceUids', [])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['attendeeUids', 'attendeeNames', 'joinedAt'])
          && (
               // Joining: exactly one uid added, and it's yours.
               (after.size() == before.size() + 1 && uid in after && !(uid in before))
               // Leaving: exactly one removed, and it's yours.
               || (after.size() == before.size() - 1 && !(uid in after) && uid in before)
             );
      }

      // Proposing a different time or place on a plan you were invited to.
      //
      // Same shape as the RSVP exception above: the caller must be someone the
      // plan was addressed to, the write must touch nothing but `suggestions`,
      // and within that map it must touch nothing but their own uid. That last
      // check is what stops anyone editing, forging or deleting a suggestion
      // that isn't theirs while still letting them write their own.
      function isSuggestion() {
        let uid = request.auth.uid;
        return uid in resource.data.get('audienceUids', [])
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['suggestions'])
          && request.resource.data.get('suggestions', {})
               .diff(resource.data.get('suggestions', {})).affectedKeys()
               .hasOnly([uid]);
      }

      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.hostUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;
      allow update: if signedIn()
                    && (resource.data.hostUid == request.auth.uid
                        || isRsvp()
                        || isSuggestion());
    }
  }
}
